# Font files never change under the same name, so cache them for good.
# CSS and JS links carry a ?v= hash of the file (written by sync.mjs), so a
# changed file gets a new URL and the old one can be cached for good. This
# stops every page change from revalidating each stylesheet and script.
/fonts/*
  Cache-Control: public, max-age=31556952, immutable

/css/*
  Cache-Control: public, max-age=31556952, immutable

/js/*
  Cache-Control: public, max-age=31556952, immutable

# no-transform stops Cloudflare injecting its bot-detection script into pages
# (Best Practices 100 to 81 in Lighthouse). It also stops the automatic Web
# Analytics beacon, so the pages carry the beacon themselves. Listed per page:
# a wildcard would stack on top of the rules above.
/
  Cache-Control: no-transform

/about/
  Cache-Control: no-transform

/pricing/
  Cache-Control: no-transform

/contact/
  Cache-Control: no-transform

/404.html
  Cache-Control: no-transform

# Files at the top level keep the same name when they change (icons, the
# share image), so cache them for a day only. Not a wildcard: Cloudflare
# would stack a wildcard's header on top of the /fonts/ rule above.
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400
